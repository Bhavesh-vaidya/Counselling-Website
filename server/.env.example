# Copy to server/.env and fill in. NEVER commit server/.env
PORT=5000

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=rzp_test_DEMO_KEY_ID
RAZORPAY_KEY_SECRET=DEMO_KEY_SECRET

# Email: every email is sent FROM and delivered TO anoracounselling@gmail.com.
# Only the app password is needed here (Google Account -> Security ->
# 2-Step Verification ON -> App passwords). Spaces in it are fine.
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Google Meet link included in the client's confirmation email
MEET_LINK=https://meet.google.com/demo-link-here

# Your website URL(s) allowed to call this server (leave empty while developing)
# CORS_ORIGIN=https://<your-github-username>.github.io
